[gd_resource type="StandardMaterial3D" load_steps=4 format=3]

; Металл квартала, ревизия t35 (фикс «белой искры» на перилах при скользящем угле).
;
; Причина: искра — specular-алиасинг, а не UV. Два источника высокочастотного блеска:
;   1) процедурная карта roughness с мелкой шлифовкой — при сильном minification
;      (тонкие перила, скользящий угол) соседние пиксели дают то 0.2, то 0.8 roughness,
;      блик «рвётся» в точку и выжигается в белый;
;   2) normal map с сильной шлифовкой (normal_scale 0.8) усиливает эту рвань.
;
; Что сделано (только материал, текстуры не перегенерировал):
;   * roughness_texture ОТКЛЮЧЕНА — постоянная roughness 0.55: блик широкий, без искр;
;   * normal_scale 0.80 → 0.50: рельеф шлифовки остаётся, но не рвёт спекуляр;
;   * metallic 0.75 → 0.80 и metallic_specular 0.55 → 0.40: отражение тонируется
;     альбедо металла (серо-стальной), а не уходит в белый; металл остаётся металлом.
;
; Если после кадров искра где-то останется (тонкие прутья под 5°): следующий шаг —
; normal_scale 0.30 или полное отключение normal_enabled; запас по «мыльности» есть.

[ext_resource type="Texture2D" path="res://assets/textures/metal/metal_diff_2k.png" id="1_albedo"]
[ext_resource type="Texture2D" path="res://assets/textures/metal/metal_normal_2k.png" id="2_normal"]
[ext_resource type="Texture2D" path="res://assets/textures/metal/metal_ao_2k.png" id="4_ao"]

