[gd_resource type="StandardMaterial3D" load_steps=4 format=3]

; Асфальт ночью (ревизия t13, вторая итерация по кадрам docs/shots_art/):
; 1) сначала noise давал roughness 0..0.72 при uv1_scale 32 — «лужи масла», золотые блики;
; 2) затем слишком тёмный albedo (0.055) сделал землю «чёрным линолеумом» — фактура
;    пропала, блики стали тусклыми пятнами.
; Целевое состояние: серый асфальт с читаемой фактурой в свете фонарей, узкий мокрый
; отблеск под лампой. Поэтому: albedo ×1.7, roughness 0.75, metallic 0.23, uv1_scale 22
; (мелкая фактура вблизи), разброс шума 0.78..1.0 — мягкий, без контрастных луж.

[sub_resource type="FastNoiseLite" id="NoiseWet"]
noise_type = 2
seed = 7
frequency = 0.008
fractal_octaves = 4
fractal_lacunarity = 2.0
fractal_gain = 0.5

[sub_resource type="Gradient" id="RampWet"]
offsets = PackedFloat32Array(0, 0.4, 0.75, 1)
colors = PackedColorArray(0.78, 0.78, 0.78, 1, 0.86, 0.86, 0.86, 1, 1, 1, 1, 1, 1, 1, 1, 1)

[sub_resource type="NoiseTexture2D" id="TexWetRoughness"]
width = 512
height = 512
generate_mipmaps = true
seamless = true
seamless_blend_skirt = 0.15
color_ramp = SubResource("RampWet")
noise = SubResource("NoiseWet")

[resource]
resource_name = "asphalt"
albedo_color = Color(0.094, 0.099, 0.116, 1)
metallic = 0.23
metallic_specular = 0.5
roughness = 0.75
roughness_texture = SubResource("TexWetRoughness")
roughness_texture_channel = 4
uv1_scale = Vector3(22, 22, 22)
