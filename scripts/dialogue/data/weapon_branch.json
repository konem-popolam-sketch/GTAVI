    "speaker": "Нил",
    "start": "cp_01",
    "nodes": {
      "cp_01": {
        "text": "Двадцать два сорок. Смена.",
        "next": "cp_02"
      },
      "cp_02": {
        "text": "Коробка на прилавке. Как всегда.",
        "next": null
      }
    }
