{
  "kostya_gun": {
    "title": "Костя: тайник",
    "speaker": "Костя",
    "start": "kg_01",
    "nodes": {
      "kg_01": {
        "text": "Ты слышал, как оно внизу шуршит? Значит, и тебя слышат. Иди сюда.",
        "next": "kg_02"
      },
      "kg_02": {
        "text": "Те двое. У них под куртками не планшеты. Я таких навидался, пока тут сижу.",
        "next": "kg_03"
      },
      "kg_03": {
        "text": "И ты не думай, что тебя не тронут. Твоя подпись в журнале. Тебя сотрут, как Севу.",
        "next": "kg_04"
      },
      "kg_04": {
        "text": "Ну? Будешь до утра ждать, пока они сами придут?",
        "choices": [
          {
            "text": "Мне это не нужно.",
            "next": "kg_05"
          },
          {
            "text": "А если нужно?",
            "next": "kg_06"
          }
        ]
      },
      "kg_05": {
        "text": "Нужно, не нужно. Ты уже в списке, курьер. Хоть с чем-то в кармане.",
        "next": "kg_07"
      },
      "kg_06": {
        "text": "Значит, слушай внимательно. Один раз объясняю.",
        "next": "kg_07"
      },
      "kg_07": {
        "text": "Второй переулок. У контейнера, где трава. Жестянка из-под печенья. Возьми и не свети.",
        "next": "kg_08",
        "effect": {
          "objective": "Забери то, что оставил Костя",
          "set_flag": "weapon_hint"
        }
      },
      "kg_08": {
        "text": "И мне не показывай. Я не видел.",
        "next": null,
        "effect": {
          "set_flag": "weapon_hint_done"
        }
      }
    }
  },
  "weapon_pickup": {
    "title": "Тайник у контейнера",
    "speaker": "Нил",
    "start": "wp_01",
    "nodes": {
      "wp_01": {
        "text": "Жестянка. Как в детстве, только тяжелее.",
        "next": "wp_02"
      },
      "wp_02": {
        "text": "Промасленная тряпка. ТТ без номера, обойма на три. Один уже в стволе.",
        "next": "wp_03"
      },
      "wp_03": {
        "text": "Три патрона. Больше и не надо.",
        "next": null,
        "effect": {
          "objective": "Сходи к шлагбауму. Он всё равно тебя ждёт",
          "flags": {
            "item_weapon": true,
            "weapon_found": true
          }
        }
      }
    }
  },
  "timur_gun": {
    "title": "Тимур: щелчок",
    "speaker": "Тимур",
    "start": "tg_01",
    "nodes": {
      "tg_01": {
        "text": "Эй. Это ты там щёлкаешь? У меня аж чай дрогнул.",
        "next": "tg_02"
      },
      "tg_02": {
        "text": "Чего в кармане? Куртка оттопыривается.",
        "next": "tg_03"
      },
      "tg_03": {
        "text": "Ну? Чего молчишь?",
        "choices": [
          {
            "text": "Ключи. От гаража.",
            "next": "tg_04"
          },
          {
            "text": "Вот. Смотри и забудь.",
            "next": "tg_05"
          }
        ]
      },
      "tg_04": {
        "text": "Ну да. Затвор. Чай дрогнул.",
        "next": "tg_06"
      },
      "tg_05": {
        "text": "Убери. Пожалуйста. Я не видел, я вообще спал.",
        "next": "tg_06",
        "effect": {
          "flags": {
            "timur_saw_weapon": true,
            "timur_silent": true,
            "weapon_drawn": true
          }
        }
      },
      "tg_06": {
        "text": "Иди уже. И если что — я спал.",
        "next": null
      }
    }
  },
  "guard_confront": {
    "title": "У шлагбаума",
    "speaker": "Проверяющий",
    "start": "gc_01",
    "nodes": {
      "gc_01": {
        "text": "Смена не закрыта. Дальше не пройдёшь.",
        "next": "gc_02"
      },
      "gc_02": {
        "speaker": "Нил",
        "text": "Мне к пирсу.",
        "next": "gc_03"
      },
      "gc_03": {
        "text": "Пирс закрыт. До шести всё закрыто.",
        "next": "gc_04"
      },
      "gc_04": {
        "speaker": "Нил",
        "text": "Я девятый. Моя подпись в журнале.",
        "next": "gc_05"
      },
      "gc_05": {
        "text": "Знаю. Поэтому и стою здесь, а не у машины.",
        "next": "gc_06"
      },
      "gc_06": {
        "speaker": "Нил",
        "text": "У меня в кармане не ключи.",
        "next": "gc_07"
      },
      "gc_07": {
        "text": "Ты достал его на улице. Значит, теперь это уже не моя смена.",
        "choices": [
          {
            "text": "Выстрелить в воздух.",
            "next": "gc_08"
          },
          {
            "text": "Показать ствол.",
            "next": "gc_09"
          },
          {
            "text": "Убрать ствол.",
            "next": "gc_10"
          }
        ],
        "effect": {
          "objective": "Реши, что делать",
          "set_flag": "guard_confronted"
        }
      },
      "gc_08": {
        "speaker": "Нил",
        "text": "Вверх. Только вверх.",
        "next": null,
        "effect": {
          "set_flag": "weapon_discharged"
        }
      },
      "gc_09": {
        "text": "Записал. Ствол. Девятый.",
        "next": null,
        "effect": {
          "flags": {
            "guard_note": true,
            "weapon_brandished": true
          }
        }
      },
      "gc_10": {
        "text": "Как хочешь.",
        "next": null,
        "effect": {
          "set_flag": "weapon_holstered"
        }
      }
    }
  },
  "guard_aftermath": {
    "title": "После шлагбаума",
    "speaker": "Проверяющий",
    "start": "ga_01",
    "nodes": {
      "ga_01": {
        "text": "Слышал? Это не тебе сигнал. Это им.",
        "next": "ga_02"
      },
      "ga_02": {
        "speaker": "Нил",
        "text": "Кому — им?",
        "next": "ga_03"
      },
      "ga_03": {
        "text": "Тем, кто платит. Я здесь просто смена.",
        "next": "ga_04"
      },
      "ga_04": {
        "speaker": "Костя",
        "text": "Дальше я сам. Тебе с ним не дойти.",
        "next": "ga_05",
        "effect": {
          "set_flag": "weapon_disposed"
        }
      },
      "ga_05": {
        "text": "Уходи. Пока я не записал тебя в утренний список.",
        "next": null,
        "effect": {
          "objective": "Вернись к «Луне»: Мила у витрины",
          "set_flag": "guard_aftermath_seen"
        }
      }
    }
  },
  "cut_prologue": {
